 "poems": [
  {
   "seq": "1",
   "text": "散かゝる花やむかしのわきもこのかさねし袖の匂ひ成らむ",
   "kana": "",
   "speaker": "菅原在良朝臣集",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "水そこに春やとまると尋みむうつろふ花のかけにならひて",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "春霞たちかへりゆく通路をしはしとゝめよ雲のかけはし",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "かく計りをやみたにせぬ五月雨にいかてかたこの早苗とる覽",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "子規まつとせしまにふしまちの月こそたかく空に成ぬれ",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "都人まつらんものを山里に聞ふるしたるほとゝきすかな",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "ゆふされはなひくをさゝの音にこそおもはぬ秋の風は立けれ",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "山里のくすのうら葉を吹かへす風のけしきに秋をしるかな",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "さよ深くあふせたつぬる彥星は其むつことのほともあらしな",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "天河ほしあひの空も見ゆはかりたちなへたてそ夜はの秋霧",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "月かけに秋のよすから起ゐつゝうつ衣手に霜やをくらん",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "つき故になかきよすからなかむれはあかすも惜き秋の空かな",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "いつよりも月のゝとかに見ゆる哉千とせの秋の初と思へは",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "よるきたる錦とは見よ散かゝる紅葉も月も隈しなけれは",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "白菊のかきほの花をなかむとて住家ならてもくらしつるかな",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "かたしきのねさめの床のむしの音は哀みにしむ物にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "女郞花匂へる野へを尋ぬとてぬれこそきたれ道しはの露",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "名にたかきこ宵の月にあくかれて露とをきいてあかしぬる哉",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "なさけなき別れし秋の戀しさに露そたちうき菊のあたりは",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "山深みしくるゝ空をなかむとてはかなくけふもくらしつる哉",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "うたゝねに衣のさゆる景色にてよしのゝ山の雪をしそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "老ぬれは我身とのみも見ゆる哉蓬かうへにふれるしら雪",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "淋しさはいつにもまさる小倉山ふもとの里の冬のけしきは",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "諸共にたちきし人を戀わひてかたみの衣なく〓〓そうつ",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "宮城のにかれにし花のかなしきはおられぬ萩のうへも露けし",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "宮城のゝ小萩か末のかれしより鹿そかひなき音をやたてける",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "くさ〓〓に遠のしるしを志らせしもひとつ御法のゆかり成鳬",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "岸ちかくおひたる松の綠こそ池に千とせの影はとゝむれ",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "嬉しさの行末とをくみゆるかな干とせをまつの宿のしるしは",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "紫の雲ゐをねかふ身にしあれはかねてむかへを契り社をけ",
   "kana": "",
   "speaker": "藤原基俊家集上",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "いく千世と契りをきけむ我宿の年に生そふまつの梢を",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "池水もいひやもらせる千とせまて流れてしまむ君かやとゝは",
   "kana": "",
   "speaker": "",
   "page": 421,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
